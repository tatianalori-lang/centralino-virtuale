# ---------------------------------------------------------------------------
# IVR: modalità di risposta
# ---------------------------------------------------------------------------
# voice = solo voce, nessun tasto richiesto (default)
# both  = voce + tasti DTMF come fallback silenzioso
IVR_INPUT=voice

# Dopo quanti secondi di inattività una chiamata non completata apre comunque
# il ticket (anche senza callback di stato dal provider). Minimo 5, default 30.
IVR_ABANDON_SECONDS=30

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# URL pubblico HTTPS che Twilio chiama (es. il tuo dominio o un tunnel ngrok).
# Senza questo valore il server prova a ricostruirlo dalla richiesta.
# Esempio: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Nome usato dal centralino nella frase di benvenuto
COMPANY_NAME=Assistenza Clienti ACME

# Messaggio di benvenuto pronunciato all'inizio della chiamata
WELCOME_MESSAGE=Buongiorno MT Italia

# ---------------------------------------------------------------------------
# Twilio (Console > Account > Account SID e Auth Token)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Numero Twilio che riceve le chiamate (formato E.164, es. +390212345678).
# È il numero del centralino virtuale su Twilio.
TWILIO_PHONE_NUMBER=
# SID della risorsa numero (per aggiornare il webhook via API)
TWILIO_NUMBER_SID=

# Numero a cui deviare le chiamate quando il PC è spento (fallback Telnyx)
FALLBACK_PHONE_NUMBER=+39067821202

# ---------------------------------------------------------------------------
# Telnyx (numero italiano diretto, senza Twilio)
# ---------------------------------------------------------------------------
# API key v2: Mission Control Portal > API Keys > Create API Key.
# NON usare email/password: le API richiedono il bearer token KEY_...
TELNYX_API_KEY=
TELNYX_TEXML_APP_ID=
TELNYX_REQUIREMENT_GROUP_ID=
TELNYX_NUMBER_ID=
TELNYX_PHONE_NUMBER=
TELNYX_VOICE=Polly.Bianca
TELNYX_LANGUAGE=it-IT
# Chiave pubblica Ed25519 per validare i webhook (opzionale, consigliata)
TELNYX_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Notifiche WhatsApp (via Telnyx, senza Twilio)
# ---------------------------------------------------------------------------
# NOTIFY_CHANNEL: email (default) | whatsapp | both
NOTIFY_CHANNEL=email
WHATSAPP_ENABLED=false
WHATSAPP_FROM=+39067821202
WHATSAPP_TO=+39067821202
# Se true, il messaggio va al numero del chiamante invece che a WHATSAPP_TO
WHATSAPP_TO_CALLER=false
# Fuori dalla finestra di 24h WhatsApp richiede un template approvato
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=it

# ---------------------------------------------------------------------------
# Email dei ticket (SMTP Aruba)
# ---------------------------------------------------------------------------
# Casella su dominio Aruba: smtps.aruba.it:465 con SSL/TLS (richiede TLS 1.2).
# Compila SMTP_USER con l'indirizzo email completo e SMTP_PASS con la password.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=assistenza@mtitaliaretail.com

# ---------------------------------------------------------------------------
# Centralino e inoltro
# ---------------------------------------------------------------------------
# Numero del centralino mostrato nella dashboard.
CENTRALINO_NUMBER=067821202

# Numero italiano (linea TIM da portare su Twilio); usato nei promemoria.
ITALIAN_NUMBER=067821202

# Numero a cui inoltrare le chiamate (formato E.164).
# Usato dal tasto 0 durante la chiamata e dalla modalità di inoltro diretto.
FORWARD_NUMBER=+39067821202

# Alias storico di FORWARD_NUMBER (opzionale).
OPERATOR_PHONE_NUMBER=

# Verifica della firma X-Twilio-Signature. Consigliato: true in produzione.
VALIDATE_TWILIO_SIGNATURE=true

# Voce e lingua usate da <Say>. Polly.Bianca è una voce italiana.
TWILIO_VOICE=Polly.Bianca
TWILIO_LANGUAGE=it-IT

# Fuso orario usato per date e numerazione ticket
TZ=Europe/Rome

# ---------------------------------------------------------------------------
# Gestione Interventi (OSM): il ticket diventa una SCHEDA DI INTERVENTO TECNICO
# ---------------------------------------------------------------------------
INTERVENTI_URL=https://interventi.mtinterventi.com
INTERVENTI_USERNAME=
INTERVENTI_PASSWORD=
INTERVENTI_AUTO_OPEN=true
# Anagrafica OSM di fallback quando il chiamante non è riconosciuto.
INTERVENTI_DEFAULT_CLIENTE=

# Vuoto = tipo e stato risolti automaticamente dai metadati OSM:
#   tipo  «Settore tecnico» (id 1)
#   stato «1 DA PROGRAMMARE» (id 2)
# Lo stato «8 PROMEMORIA» (id 9) NON viene mai usato.
# Imposta questi due valori solo per forzare ID diversi.
INTERVENTI_TIPO_ID=
INTERVENTI_STATO_ID=

# ---------------------------------------------------------------------------
# Webex Calling / TIM: storico chiamate (numero del chiamante originale)
# ---------------------------------------------------------------------------
# Token con scope spark-admin:calling_cdr_read (Service App o token personale
# di un amministratore). Serve per leggere il CDR con il CLI originale, che la
# deviazione TIM non passa al centralino. Vedi scripts/webex-cdr.mjs.
WEBEX_TOKEN=
